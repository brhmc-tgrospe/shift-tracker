# ==========================================================
# Environment Configuration Template
# DO NOT COMMIT OR SHARE ACTUAL CREDENTIALS!
# Copy this file to .env and insert your environment-specific credentials.
# ==========================================================

# Database Connection URL (PostgreSQL / Neon)
# In development, create your own branch on Neon or your own free Neon database:
DATABASE_URL="postgresql://username:password@ep-branch-name.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication (Use a secure random string)
JWT_SECRET="your-secure-random-jwt-secret-key-here"

# Server Port (Defaults to 3001 if not set)
PORT=3001

# Environment Mode ('development' | 'production')
NODE_ENV="development"
